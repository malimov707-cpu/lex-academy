APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Main Chat AI
AI_CHAT_PROVIDER=openai
AI_CHAT_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-6.2-sol

# Advanced Legal Reasoning
AI_REASONING_MODEL=gpt-6.2-astra

# Real-time AI Voice
AI_VOICE_PROVIDER=openai
AI_VOICE_MODEL=gpt-live-1.1
AI_VOICE_MODE=webrtc

# Transcription
AI_TRANSCRIPTION_MODEL=gpt-live-transcribe

# Group Virtual Courtroom
COURTROOM_AUDIO_PROVIDER=livekit
COURTROOM_AI_EVALUATION_MODEL=gpt-6.2-sol

# Secret
OPENAI_API_KEY=

# Existing OpenAI-compatible AI provider (Backward Compatibility)
AI_TUTOR_API_KEY=
AI_TUTOR_BASE_URL=https://api.openai.com/v1
AI_TUTOR_MODEL=gpt-6.2-sol
AI_TUTOR_MAX_CONTEXT=12

# Official domains allowed for scheduled legal-source change checks
LEGAL_SOURCE_MONITOR_HOSTS=lex.uz,www.lex.uz

# Virtual Courtroom (raw audio recording is always disabled in v1)
VIRTUAL_COURTROOM_ENABLED=true
VIRTUAL_COURTROOM_MAX_SESSION_MINUTES=90
VIRTUAL_COURTROOM_CONTEXT_TURNS=12
VIRTUAL_COURTROOM_VOICE_MODE=browser
VIRTUAL_COURTROOM_BROWSER_SPEECH_ENABLED=true
VIRTUAL_COURTROOM_TRANSCRIPT_RETENTION_DAYS=30
VIRTUAL_COURTROOM_SCENE_MODE=webgl
VIRTUAL_COURTROOM_SCENE_QUALITY=auto
VIRTUAL_COURTROOM_SERVER_SPEECH_ENABLED=false
AI_VOICE_API_KEY=
AI_STT_MODEL=gpt-transcribe
AI_REALTIME_MODEL=gpt-realtime-2.1-mini
AI_TTS_MODEL=gpt-4o-mini-tts
AI_TTS_VOICE=coral
AI_TTS_PROVIDER=azure
AI_TTS_INWORLD_API_KEY=
AI_TTS_INWORLD_VOICE=

# Microsoft Azure Speech Service
AZURE_SPEECH_ENABLED=true
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westus2
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_MALE_VOICE=uz-UZ-SardorNeural
AZURE_SPEECH_FEMALE_VOICE=uz-UZ-MadinaNeural
AZURE_SPEECH_NARRATOR_VOICE=uz-UZ-MadinaNeural
